				(pintype "bidirectional+no_connect")
			)
		)
		(net
			(code "55")
			(name "unconnected-(U1-VIN-Pad1)")
			(class "Default")
			(node
				(ref "U1")
				(pin "1")
				(pinfunction "VIN_1")
				(pintype "power_out+no_connect")
			)
		)
	)
)
